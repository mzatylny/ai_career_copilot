# Copy this file to .env
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Development defaults
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=career_documents
MAX_UPLOAD_MB=12
MAX_CONTEXT_CHUNKS=5
MAX_PDF_PAGES=250
EMBEDDING_BATCH_SIZE=64

# Safe defaults: the copied file runs locally without calling OpenAI.
# Add a real API key and set both values to false to enable live AI.
AI_COPILOT_MOCK_LLM=true
AI_COPILOT_MOCK_EMBEDDINGS=true
