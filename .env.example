# Copy this file to .env
OPENAI_API_KEY=
AI_COPILOT_API_KEY=
# Preferred multi-tenant format: team-a:key-one,team-b:key-two
AI_COPILOT_TENANT_KEYS=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Development defaults
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=career_documents
SESSION_DATABASE_PATH=./data/sessions.db
OBJECT_STORAGE_PATH=./data/objects
MAX_UPLOAD_MB=12
MAX_CONTEXT_CHUNKS=5
MAX_PDF_PAGES=250
MAX_DOCUMENT_CHARACTERS=2000000
MAX_DOCUMENT_CHUNKS=2000
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_SIZE=512
REQUESTS_PER_MINUTE=60
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1800
LOG_LEVEL=INFO
EXPOSE_DOCS=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Safe free-demo defaults. Set both false and add OPENAI_API_KEY for live AI.
AI_COPILOT_MOCK_LLM=true
AI_COPILOT_MOCK_EMBEDDINGS=true
